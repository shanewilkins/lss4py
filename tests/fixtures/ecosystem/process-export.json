{
  "process": {
    "id": "intake_baseline",
    "name": "Intake baseline",
    "version": 2,
    "items": [
      {
        "id": "order",
        "name": "Order",
        "kind": "information"
      },
      {
        "id": "ticket",
        "name": "Work ticket",
        "kind": "information"
      },
      {
        "id": "document",
