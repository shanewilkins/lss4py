            "value": 20,
            "unit": "min"
          }
        },
        "primary": "declared",
        "analysis_input": "declared"
      },
      "kind": "task"
    },
    {
      "id": "split",
      "name": "Begin parallel reviews",
      "kind": "parallel_split"
    },
    {
      "id": "review",
      "name": "Review",
      "consumes": [
        "ticket"
      ],
      "cycle_time": {
        "basis": "planned",
        "results": {
          "declared": {
            "method": "mean",
            "value": 30,
            "unit": "min"
          }
        },
        "primary": "declared",
        "analysis_input": "declared"
      },
      "kind": "task"
    },
    {
      "id": "review_check",
      "name": "Review approved?",
      "kind": "decision"
    },
    {
      "id": "approval",
      "name": "Approval",
      "consumes": [
        "document"
      ],
      "produces": [
