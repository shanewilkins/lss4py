        "basis": "planned",
        "results": {
          "declared": {
            "method": "mean",
            "value": 15,
            "unit": "min"
          }
        },
        "primary": "declared",
        "analysis_input": "declared"
      },
      "kind": "task"
    },
    {
      "id": "join",
      "name": "Complete parallel reviews",
      "kind": "parallel_join"
    },
    {
      "id": "close",
      "name": "Close",
      "consumes": [
        "approved_document"
      ],
      "cycle_time": {
        "basis": "planned",
        "results": {
          "declared": {
            "method": "mean",
            "value": 10,
            "unit": "min"
          }
        },
        "primary": "declared",
        "analysis_input": "declared"
      },
      "kind": "task"
    },
    {
      "id": "end",
      "name": "End",
      "kind": "end"
