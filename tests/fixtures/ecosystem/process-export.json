    },
    {
      "source": "approval",
      "target": "join"
    },
    {
      "source": "join",
      "target": "close"
    },
    {
      "source": "close",
      "target": "end"
    },
    {
      "source": "review_check",
      "target": "review",
      "outcome": "revise",
      "handoff": {},
      "rework": {}
    }
