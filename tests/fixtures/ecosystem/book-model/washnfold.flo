# FLO 0.5: timing profiles are first-class; primary selects the displayed mean.
# No analysis_input is selected: this map does not model end-to-end elapsed time.
# The order release queue overlaps the load Wash wait; show only the order projection.
# Promoted waiting profiles live on queues only, so the drawing labels each wait once.

spec_version: '0.1'
process:
  id: wash_n_fold
  name: Wash n' Fold Current State
  version: 2
  resources:
  - id: Customer
    name: Customer
    kind: person
  - id: Staff
    name: Staff
    kind: person
steps:
- id: start
  name: Start
  kind: start
  description: Customer order is dropped off
- id: dropoff
  name: Drop-off and ticket
  kind: task
  performed_by:
  - Customer
  - Staff
  value_class: RNVA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Drop-off and ticket
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 5.1
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Drop-off and ticket
    extensions:
      mpi:measurement_id: dropoff_wait
  changeover_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 0.0
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Drop-off and ticket
- id: sort_tag
  name: Sort and tag
  kind: task
  performed_by:
  - Staff
  value_class: RNVA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 4.8
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Sort and tag
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 4.5
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Sort and tag
    extensions:
      mpi:measurement_id: sort_tag_wait
  changeover_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 0.0
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Sort and tag
- id: wash_release_queue
  name: Batch Release Queue
  kind: queue
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 501.7
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: order
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#first-load-release
    extensions:
      mpi:measurement_id: order_batch_release_wait
- id: wash
  name: Wash loads
  kind: task
  performed_by:
  - Staff
  value_class: VA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 30.4
        unit: min
    primary: mean
    observation_count: 65
    observation_unit: load
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Wash
  changeover_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 1.5
        unit: min
    primary: mean
    observation_count: 65
    observation_unit: load
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Wash
- id: dry
  name: Dry loads
  kind: task
  performed_by:
  - Staff
  value_class: VA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 45.3
        unit: min
    primary: mean
    observation_count: 65
    observation_unit: load
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Dry
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 0.8
        unit: min
    primary: mean
    observation_count: 65
    observation_unit: load
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Dry
    extensions:
      mpi:measurement_id: dry_wait
  changeover_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 0.7
        unit: min
    primary: mean
    observation_count: 65
    observation_unit: load
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Dry
- id: fold_package
  name: Reunite, fold, and package
  kind: task
  performed_by:
  - Staff
  value_class: VA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 16.2
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Fold and package
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 3.6
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Fold and package
    extensions:
      mpi:measurement_id: fold_package_wait
  changeover_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 0.5
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Fold and package
- id: packaging_check
  name: Packaging check passes?
  kind: decision
- id: notification_queue
  name: Notification Batch Queue
  kind: queue
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 37.9
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Stage for collection
- id: stage
  name: Stage for collection
  kind: task
  performed_by:
  - Staff
  value_class: RNVA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Stage for collection
- id: notify
  name: Send readiness notification
  kind: task
  performed_by:
  - Staff
  value_class: VA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 1
        unit: min
    primary: mean
    observation_count: 39
    observation_unit: order
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Send readiness notification
- id: correction_queue
  name: Fold Correction Queue
  kind: queue
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 5.6
        unit: min
    primary: mean
    observation_count: 5
    observation_unit: correction
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Fold correction
- id: fold_correction
  name: Fold correction
  kind: task
  performed_by:
  - Staff
  value_class: NVA
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 6.8
        unit: min
    primary: mean
    observation_count: 5
    observation_unit: correction
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Fold correction
  changeover_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 0.0
        unit: min
    primary: mean
    observation_count: 5
    observation_unit: correction
    cohort: Friday 91
    aggregation_level: activity
    observation_window: Representative Friday
    evidence_ref: data/washnfold/washnfold_event_log.csv#Fold correction
- id: end
  name: Stop
  kind: end
  description: Completed order is staged and customer is notified
transitions:
- source: start
  target: dropoff
- source: dropoff
  target: sort_tag
- source: sort_tag
  target: wash_release_queue
- source: wash_release_queue
  target: wash
- source: wash
  target: dry
- source: dry
  target: fold_package
- source: fold_package
  target: packaging_check
- source: packaging_check
  target: notification_queue
  outcome: pass
  label: 'Yes'
- source: notification_queue
  target: stage
- source: stage
  target: notify
- source: notify
  target: end
- source: packaging_check
  target: correction_queue
  outcome: fail
  label: No (5 of 39 orders)
  rework:
    reason: Packaging check failed
    frequency:
      basis: simulated
      numerator: 5
      denominator: 39
      observation_unit: order
      evidence_ref: data/washnfold/washnfold_event_log.csv#Fold correction
- source: correction_queue
  target: fold_correction
- source: fold_correction
  target: notification_queue
  label: Corrected package rejoins flow
  rework: {}
